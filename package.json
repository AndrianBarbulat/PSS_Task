{
  "name": "pss-assessment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --success first \"npm:dev:vite\" \"npm:dev:functions\"",
    "dev:vite": "vite --host 127.0.0.1",
    "dev:functions": "node --env-file-if-exists=.env scripts/local-functions-server.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "read-excel-file": "9.3.13",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "9.2.5",
    "vite": "^7.1.0"
  }
}
